      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# Upload two stereo images\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Get uploaded file names\n",
        "names = list(uploaded.keys())\n",
        "\n",
        "print(\"Uploaded files:\", names)\n",
        "\n",
        "left_img = None\n",
        "right_img = None\n",
        "\n",
        "# Correctly assign left and right images based on filenames\n",
        "# Assuming 'left' in filename corresponds to left image and 'right' to right image.\n",
        "img_dict = {}\n",
        "for name in names:\n",
        "    if 'left' in name.lower():\n",
        "        img_dict['left'] = cv2.imread(name, cv2.IMREAD_GRAYSCALE)\n",
        "    elif 'right' in name.lower():\n",
        "        img_dict['right'] = cv2.imread(name, cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "left_img = img_dict.get('left')\n",
        "right_img = img_dict.get('right')\n",
        "\n",
        "# Ensure both images are loaded\n",
        "if left_img is None or right_img is None:\n",
        "    raise ValueError(\"Could not find both 'left' and 'right' images among the uploaded files. Please ensure filenames contain 'left' and 'right'.\")\n",
        "\n",
        "# Check images (updated to reflect actual assigned images)\n",
        "print(\"Left image successfully loaded.\")\n",
        "print(\"Right image successfully loaded.\")\n",
        "\n",
        "# Display uploaded images\n",
        "plt.figure(figsize=(12,5))\n",
        "\n",
        "plt.subplot(1,2,1)\n",
        "plt.imshow(left_img, cmap='gray')\n",
        "plt.title(\"Left Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1,2,2)\n",
        "plt.imshow(right_img, cmap='gray')\n",
        "plt.title(\"Right Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.show()"
      ],
